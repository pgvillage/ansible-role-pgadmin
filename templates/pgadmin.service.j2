# {{ ansible_managed }}
[Unit]
Description=pgAdmin web application (Gunicorn)
After=network.target

[Service]
Type=simple
User={{ pgadmin_webserver_user }}
Group={{ pgadmin_webserver_group }}
WorkingDirectory={{ _pgadmin_application_dir }}
Environment="PYTHONPATH={{ pgadmin_config_dir }}"
Environment="SCRIPT_NAME={{ pgadmin_url_path }}"
ExecStart={{ pgadmin_virtualenv }}/bin/gunicorn --workers=1 --threads={{ pgadmin_gunicorn_threads }} --timeout={{ pgadmin_gunicorn_timeout }} --bind=127.0.0.1:{{ pgadmin_gunicorn_port }} --access-logfile=- --error-logfile=- pgAdmin4:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ pgadmin_data_dir }} {{ pgadmin_log_dir }}

[Install]
WantedBy=multi-user.target
